// Prisma schema for UYAN.chat Postgres backend
// Generated per new requirements: Message, Response, Report

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id         String     @id @default(uuid())
  deviceHash String
  body       String
  status     MessageStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  responses  Response[]
  reports    Report[]   @relation("MessageReports")

  @@index([status, createdAt])
  @@index([deviceHash])
}

model Response {
  id         String    @id @default(uuid())
  messageId  String
  deviceHash String
  body       String
  createdAt  DateTime  @default(now())
  isReported Boolean   @default(false)

  message    Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reports    Report[]  @relation("ResponseReports")

  @@index([messageId])
}

model Report {
  id         String   @id @default(uuid())
  messageId  String?
  responseId String?
  deviceHash String
  reason     String
  createdAt  DateTime @default(now())

  message    Message? @relation("MessageReports", fields: [messageId], references: [id])
  response   Response? @relation("ResponseReports", fields: [responseId], references: [id])
}

enum MessageStatus {
  PENDING
  ANSWERED
  BLOCKED
  DELETED
}
