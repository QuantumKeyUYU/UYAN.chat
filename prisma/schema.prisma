 datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Message {
  id         String        @id @default(cuid())
  deviceHash String
  body       String
  createdAt  DateTime      @default(now())
  status     MessageStatus @default(PENDING)

  responses Response[]
  reports   Report[]

  @@index([deviceHash])
}

model Response {
  id         String   @id @default(cuid())
  messageId  String
  deviceHash String
  body       String
  createdAt  DateTime @default(now())
  isReported Boolean  @default(false)
  seenAt     DateTime?

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([messageId])
  @@index([deviceHash])
}

model Report {
  id         String   @id @default(cuid())
  messageId  String?
  responseId String?
  deviceHash String
  reason     String
  description String?
  createdAt  DateTime @default(now())

  message  Message?  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  response Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([deviceHash])
}

enum MessageStatus {
  PENDING
  ANSWERED
  BLOCKED
  DELETED
}
